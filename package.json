{
    "name": "lumenweld",
    "displayName": "Lumenweld",
    "description": "A near-black VS Code theme with quiet workbench surfaces and balanced syntax contrast.",
    "version": "0.1.0",
    "publisher": "zigai",
    "license": "MIT",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/zigai/vscode-lumenweld.git"
    },
    "bugs": {
        "url": "https://github.com/zigai/vscode-lumenweld/issues"
    },
    "homepage": "https://github.com/zigai/vscode-lumenweld#readme",
    "engines": {
        "vscode": "^1.84.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "dark theme",
        "black theme",
        "near black",
        "lumenweld",
        "color theme",
        "vs code"
    ],
    "galleryBanner": {
        "color": "#050505",
        "theme": "dark"
    },
    "scripts": {
        "check": "npm run format:check",
        "format": "prettier --write \"*.md\" \"*.json\"",
        "format:check": "prettier --check \"*.md\" \"*.json\"",
        "package": "node -e \"require('fs').mkdirSync('dist', { recursive: true })\" && vsce package --out dist/lumenweld.vsix",
        "publish": "vsce publish"
    },
    "contributes": {
        "themes": [
            {
                "label": "Lumenweld",
                "uiTheme": "vs-dark",
                "path": "./themes/lumenweld-theme.json"
            },
            {
                "label": "Lumenweld Black",
                "uiTheme": "vs-dark",
                "path": "./themes/lumenweld-black-theme.json"
            }
        ]
    },
    "devDependencies": {
        "@vscode/vsce": "^3.9.2",
        "prettier": "^3.8.4"
    }
}
