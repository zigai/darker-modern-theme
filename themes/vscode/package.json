{
  "name": "darker-modern",
  "displayName": "Darker Modern",
  "description": "The VS Code package for the Darker Modern and Darker Modern Black dark themes.",
  "version": "0.1.0",
  "publisher": "zigai",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zigai/darker-modern-theme.git"
  },
  "bugs": {
    "url": "https://github.com/zigai/darker-modern-theme/issues"
  },
  "homepage": "https://github.com/zigai/darker-modern-theme#readme",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "black theme",
    "near black",
    "darker-modern",
    "color theme",
    "vs code"
  ],
  "galleryBanner": {
    "color": "#050505",
    "theme": "dark"
  },
  "scripts": {
    "check": "npm run format:check",
    "format": "prettier --write \"README.md\" \"package.json\" \"themes/*.json\"",
    "format:check": "prettier --check \"README.md\" \"package.json\" \"themes/*.json\"",
    "package": "node -e \"require('fs').mkdirSync('dist', { recursive: true })\" && vsce package --out dist/darker-modern.vsix",
    "publish": "vsce publish"
  },
  "contributes": {
    "themes": [
      {
        "label": "Darker Modern",
        "uiTheme": "vs-dark",
        "path": "./themes/darker-modern-theme.json"
      },
      {
        "label": "Darker Modern Black",
        "uiTheme": "vs-dark",
        "path": "./themes/darker-modern-black-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "prettier": "^3.8.4"
  }
}
